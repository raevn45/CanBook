# Local development can leave this unset because Vite proxies /api to Flask on port 5000.
# Hosted CanBook uses the same-origin Cloudflare Pages /api proxy, so this can also stay unset.
# Only set this if you intentionally want the browser to call Flask directly.
# VITE_API_BASE_URL=https://YOUR-CANBOOK-API.onrender.com/api
